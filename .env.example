APP_NAME=StudyFlow API
LOG_LEVEL=INFO
# Set a unique random secret with at least 32 characters.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# PostgreSQL connection settings. Use your own password.
DB_USER=postgres
DB_PASSWORD=replace_with_your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studyflow
API_PORT=8000
POSTGRES_PORT=5433
FRONTEND_PORT=5173
# Set the host computer's LAN IP for HTTPS access from another device.
LAN_HOST=192.168.1.100
LAN_HTTPS_PORT=8443
# Create a key in Google AI Studio. Never expose it in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
AI_RATE_LIMIT_PER_DAY=300
TTS_RATE_LIMIT_PER_DAY=500
LOGIN_RATE_LIMIT_PER_15_MIN=240
FAILED_LOGIN_LIMIT=20
LOGIN_LOCK_MINUTES=15
REGISTRATION_RATE_LIMIT_PER_DAY=40
# Optional secret for GET /internal/metrics. Empty disables the endpoint.
METRICS_TOKEN=
# Alternative: DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/studyflow
