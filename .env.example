APP_NAME=StudyFlow API
LOG_LEVEL=INFO
# Wpisz własny losowy sekret o długości co najmniej 32 znaków.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Dane połączenia z PostgreSQL.
DB_USER=postgres
DB_PASSWORD=twoje_haslo
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studyflow
API_PORT=8000
POSTGRES_PORT=5433
FRONTEND_PORT=5173
# Dla dostępu HTTPS z urządzeń w tej samej sieci ustaw lokalny adres IP komputera.
LAN_HOST=192.168.1.100
LAN_HTTPS_PORT=8443
# Klucz utworzony w Google AI Studio. Nigdy nie dodawaj go do frontendu.
GEMINI_API_KEY=twoj_klucz_gemini
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
AI_RATE_LIMIT_PER_DAY=300
TTS_RATE_LIMIT_PER_DAY=500
LOGIN_RATE_LIMIT_PER_15_MIN=240
FAILED_LOGIN_LIMIT=20
LOGIN_LOCK_MINUTES=15
REGISTRATION_RATE_LIMIT_PER_DAY=40
# Opcjonalny sekret dla GET /internal/metrics; puste pole wyłącza endpoint.
METRICS_TOKEN=
# Alternatywnie: DATABASE_URL=postgresql+psycopg://postgres:twoje_haslo@localhost:5432/studyflow
